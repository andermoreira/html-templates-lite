{
	"name": "andermoreira/html-templates-lite",
	"description": "Reusable HTML/CSS templates applied to any post, page or CPT, bypassing the active theme for those URLs.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Anderson Moreira Alves",
			"homepage": "https://github.com/andermoreira"
		}
	],
	"require-dev": {
		"php": ">=7.4",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint:php": "for f in *.php includes/*.php; do php -l \"$f\" || exit 1; done",
		"lint:js": "node --check assets/admin.js && node --check assets/settings.js",
		"lint:standards": "vendor/bin/phpcs --standard=WordPress --extensions=php --ignore=*/vendor/* --parallel=8 ."
	}
}
