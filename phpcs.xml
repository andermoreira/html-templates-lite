<?xml version="1.0"?>
<ruleset name="HTML Templates Lite">
	<description>Blocking standards for the shipped plugin code.</description>

	<rule ref="WordPress">
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.ClassComment"/>
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Generic.Commenting.DocComment"/>
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	</rule>

	<!-- CPT caps generated by capability_type (see HTL_Post_Type). -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_htl_templates"/>
			</property>
		</properties>
	</rule>

	<file>html-templates-lite.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/test-kit/</exclude-pattern>
</ruleset>
